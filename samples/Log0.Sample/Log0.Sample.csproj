<Project Sdk="Microsoft.NET.Sdk">

    <!-- What the package imports for its consumers: lets the generated interceptors in. -->
    <Import Project="..\..\src\Log0\build\Log0.props" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- Proves the point: no reflection, so `dotnet publish` produces a Native AoT binary with no warnings. -->
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <ItemGroup>
        <!-- Stands in for <PackageReference Include="Log0" />, which brings both. -->
        <ProjectReference Include="..\..\src\Log0\Log0.csproj" />
        <ProjectReference Include="..\..\src\Log0.SourceGeneration\Log0.SourceGeneration.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
